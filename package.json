{
  "name": "lookmaxxing",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, on-device appearance measurement app. No photo or data ever leaves the device.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "guard": "node scripts/check-no-personal-files.mjs",
    "check": "npm run guard && npm run typecheck && npm run lint && npm test",
    "vendor": "node scripts/vendor-mediapipe.mjs",
    "predev": "node scripts/vendor-mediapipe.mjs",
    "prebuild": "node scripts/vendor-mediapipe.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
